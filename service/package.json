{
  "name": "@metering/service",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test test/**/*.test.ts",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:concurrency": "tsx --test test/concurrency/*.test.ts",
    "test:security": "tsx --test test/security/*.test.ts"
  },
  "dependencies": {"drizzle-orm": "0.44.6", "express": "5.1.0", "pg": "8.16.3"},
  "devDependencies": {"drizzle-kit": "0.31.5", "@types/express": "5.0.3", "@types/pg": "8.15.5"}
}
